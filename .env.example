# Copy this file to .env.local and fill in your own Firebase project's values.
# These are all PUBLIC client-side config values (safe to ship in a built frontend) —
# Firebase's real security boundary is firestore.rules / storage.rules, not these keys.
# Get them from: Firebase Console → Project settings → General → Your apps → SDK setup and config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Analytics measurement ID
VITE_FIREBASE_MEASUREMENT_ID=

# Base URL of your deployed Cloud Functions (used by the Orders admin page's CSV export).
# Firebase prints this after `firebase deploy --only functions`, or find it in the
# Firebase Console → Functions. Example:
# https://us-central1-your-project-id.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=

# --- Server-side only (functions/.env — NEVER prefix these with VITE_, never commit) ---
# If you later add Gemini-powered features (e.g. via Google AI Studio), put the key
# in functions/.env as GEMINI_API_KEY, not here. See docs/MIGRATION_NOTES.md.
