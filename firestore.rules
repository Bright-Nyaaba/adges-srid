rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True if the signed-in user's email is the owner or on the admin allowlist stored at meta/admins.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        (
          request.auth.token.email == 'nyaababright93@gmail.com' ||
          (
            exists(/databases/$(database)/documents/meta/admins) &&
            request.auth.token.email in get(/databases/$(database)/documents/meta/admins).data.emails
          )
        );
    }

    // Public content collections: anyone can read, content updates allowed for admin operations.
    // Mirrors the site's Leadership / Gallery / Student Projects / Resources / Store pages.
    match /leaders/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /faculty/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /gallery/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /projects/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /resources/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /store/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Editable site copy (hero headline/lede, About intro/mission/vision) — single doc at site/content.
    match /site/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Store orders (checkout, no payment collected here).
    match /orders/{id} {
      allow read, write: if true;
    }

    // Admin allowlist. An admin may read it (so the frontend can check "am I an editor?");
    // nobody may write it directly — only the addAdmin/removeAdmin Cloud Functions can,
    // since they run with the Admin SDK, which bypasses these rules entirely.
    match /meta/admins {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Everything else under meta/ is fully locked down.
    match /meta/{docId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
