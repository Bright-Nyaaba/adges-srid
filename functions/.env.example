# Server-side secrets for Cloud Functions. Copy to functions/.env and fill in.
# NEVER commit functions/.env — it is already listed in .gitignore.
#
# Nothing here is required for the site to work today. This is provided as the place
# to put a Gemini API key if you build a Google AI Studio prototype and want this
# backend to call it (e.g. an "AI-summarize this project" feature). See
# docs/MIGRATION_NOTES.md for how that would wire up.

GEMINI_API_KEY=
